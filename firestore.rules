rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.get('role', '') == 'superadmin';
    }

    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamOwner(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUserId == request.auth.uid ||
          (
            request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous' &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.get('isDemo', false) == true &&
            get(/databases/$(database)/documents/teams/$(teamId)).data.get('demoSessionOwnerId', '') == request.auth.uid
          )
        );
    }

    function isTeamCoachOfPlayer(playerId) {
      let playerData = get(/databases/$(database)/documents/players/$(playerId)).data;
      // Support both 'teamId' (legacy single) and 'primaryTeamId' (current scalar field)
      let tId = playerData.get('primaryTeamId', playerData.get('teamId', ''));
      return isSignedIn() &&
        exists(/databases/$(database)/documents/players/$(playerId)) &&
        tId != '' &&
        exists(/databases/$(database)/documents/teams/$(tId)) &&
        isTeamOwner(tId);
    }

    function isLeagueMember(leagueId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/leagues/$(leagueId)) && (
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid ||
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.get('memberUserIds', []).hasAny([request.auth.uid])
        );
    }

    // Subscription state is server-managed. Every browser-created team starts
    // free; a trusted server flow activates Pro only after a paid upgrade.
    function requestsPaidTeam() {
      return request.resource.data.get('isPro', false) == true ||
        request.resource.data.get('planId', 'free') in
          ['team', 'elite', 'league', 'school', 'squad_pro', 'squad_pro_demo'];
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
      // Profile fields are user-editable; authorization, billing, and organization
      // authority remain server-owned and are never accepted from the browser.
      allow create: if isSuperAdmin() || (isSignedIn() && isOwner(userId) &&
        request.resource.data.role in ['parent', 'adult_player', 'youth_player', 'coach', 'admin', 'league_creator'] &&
        !request.resource.data.keys().hasAny(['plan_type', 'team_limit', 'extra_teams', 'subscription_status', 'stripe_customer_id', 'stripe_subscription_id', 'isPrimaryClubAuthority', 'isStaff', 'isBetaTester', 'activePlanId', 'proTeamLimit', 'planSource'])
      );
      allow update: if isSuperAdmin() || (isSignedIn() && isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'fullName', 'email', 'phone', 'avatar', 'avatarUrl',
          'notificationsEnabled', 'seenAlertIds', 'clubName', 'clubDescription',
          'schoolName', 'institutionTitle'
        ])
      );
      allow delete: if false;

      match /tokens/{tokenId} {
        allow read, write: if false;
      }

      match /teamMemberships/{teamId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow write: if isSignedIn() && isOwner(userId);
      }

      match /clubDocuments/{docId} {
        allow read: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
        allow write: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
      }

      match /{subCollection}/{docId} {
        allow read: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
        allow write: if isSuperAdmin() || (isSignedIn() && isOwner(userId));
      }
    }

    // ─── Teams ──────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource == null ||
        isTeamOwner(teamId) ||
        isTeamMember(teamId)
      ));
      allow create: if isSuperAdmin() || (isSignedIn() && (
        request.resource.data.ownerUserId == request.auth.uid &&
        !requestsPaidTeam()
      ));
      // Only team owner can update or delete the team document itself. Client
      // updates cannot transfer ownership or alter paid plan state.
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource != null &&
        isTeamOwner(teamId) &&
        request.resource.data.ownerUserId == resource.data.ownerUserId &&
        request.resource.data.get('isPro', false) == resource.data.get('isPro', false) &&
        request.resource.data.get('planId', 'free') == resource.data.get('planId', 'free') &&
        request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free') &&
        request.resource.data.get('isDemo', false) == resource.data.get('isDemo', false) &&
        request.resource.data.get('demoSessionOwnerId', '') == resource.data.get('demoSessionOwnerId', '')
      ));
      allow delete: if isSuperAdmin() || (isSignedIn() && resource != null && isTeamOwner(teamId));

      match /members/{memberId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (
          resource == null ||
          resource.data.ownerUserId == request.auth.uid ||
          isTeamOwner(teamId) ||
          isTeamMember(teamId)
        ));
        // Membership is organization-owned. A member cannot create, promote, or
        // rewrite their own membership record.
        allow create, update, delete: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));

        match /signatures/{sigId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && (
            isTeamOwner(teamId) ||
            request.auth.uid == memberId
          ));
        }

        // Catch-all for member subcollections (staffEvaluation, notes, etc.)
        // The explicit match /members/{memberId} block takes priority over the outer team
        // catch-all, so any member sub-subcollections need their own catch-all here.
        match /{subCollection}/{docId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
        }
      }

      match /events/{eventId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));

        match /brackets/{bracketId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
        }
      }

      match /incidents/{incidentId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      match /games/{gameId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      match /fundraising/{fundId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow create, delete: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
        allow update: if isSuperAdmin() || (isSignedIn() && (
          isTeamOwner(teamId) ||
          (
            isTeamMember(teamId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finances']) &&
            request.resource.data.finances.diff(resource.data.get('finances', {}))
              .affectedKeys().hasOnly([request.auth.uid])
          )
        ));

        match /donations/{donationId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          // Public donation intents are validated and created by the server.
          // Only the primary squad owner may manually verify or correct them.
          allow create, update, delete: if isSuperAdmin() || (
            isSignedIn() && isTeamOwner(teamId)
          );
        }
      }

      // ─── Online Payment Items (coaches create payable line items) ──────────
      match /paymentItems/{itemId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      // ─── Payments (online + offline payment records) ────────────────────────
      // Server-side (webhook, Admin SDK) writes bypass these rules.
      // Coaches (team owners) can write offline records.
      // All team members can read payment records.
      match /payments/{paymentId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
      }

      // ─── Team Chat ────────────────────────────────────────────────────────
      // Members may send messages only under their own identity. Channel
      // membership and moderation remain owner-controlled.
      match /groupChats/{chatId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow create, update, delete: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));

        match /messages/{messageId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow create: if isSuperAdmin() || (isSignedIn() && isTeamMember(teamId) &&
            request.resource.data.authorId == request.auth.uid);
          allow update: if isSuperAdmin() || (isSignedIn() &&
            resource.data.authorId == request.auth.uid &&
            request.resource.data.authorId == resource.data.authorId);
          allow delete: if isSuperAdmin() || (isSignedIn() && (
            isTeamOwner(teamId) || resource.data.authorId == request.auth.uid));
        }
      }

      // ─── Coach Waiver Signatures (hub-deployed global waivers for staff) ────
      // Any team member (coach, assistant, staff) can write their own signature.
      // Only the team owner can read all signatures for compliance auditing.
      match /coachWaiverSignatures/{waiverDocId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        // A member can create/update only their OWN signature record
        allow write: if isSuperAdmin() || (isSignedIn() && (
          isTeamMember(teamId) &&
          request.resource.data.signedBy == request.auth.uid
        ) || isTeamOwner(teamId));
      }

      match /{subCollection}/{docId} {
        allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
        allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));

        match /{subSubCollection}/{subDocId} {
          allow read: if isSuperAdmin() || (isSignedIn() && (isTeamOwner(teamId) || isTeamMember(teamId)));
          allow write: if isSuperAdmin() || (isSignedIn() && isTeamOwner(teamId));
        }
      }
    }

    // ─── Players ────────────────────────────────────────────────────────────
    match /players/{playerId} {
      // Public visibility is limited to athletes who explicitly enabled their
      // recruiting profile. All other player records stay within the family/team.
      allow read: if resource.data.get('recruitingProfileEnabled', false) == true ||
        isSuperAdmin() || (isSignedIn() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('parentId', '') == request.auth.uid ||
          isTeamCoachOfPlayer(playerId)
        ));

      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('parentId', '') == request.auth.uid ||
        (request.resource.data.get('updatedByTeamId', '') != '' &&
         isTeamOwner(request.resource.data.updatedByTeamId))
      );

      // Coaches can update top-level player doc (e.g. toggleRecruitingProfile).
      // They include updatedByTeamId in the written data so we can verify ownership.
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        playerId == request.auth.uid ||
        isTeamCoachOfPlayer(playerId) ||
        (request.resource.data.get('updatedByTeamId', '') != '' &&
         exists(/databases/$(database)/documents/teams/$(request.resource.data.updatedByTeamId)) &&
         isTeamOwner(request.resource.data.updatedByTeamId))
      ));

      allow delete: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.get('parentId', '') == request.auth.uid ||
        playerId == request.auth.uid
      ));

      match /{subCollection}/{docId} {
        allow read: if get(/databases/$(database)/documents/players/$(playerId)).data.get('recruitingProfileEnabled', false) == true ||
          isSuperAdmin() || (isSignedIn() && (
            get(/databases/$(database)/documents/players/$(playerId)).data.get('userId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/players/$(playerId)).data.get('parentId', '') == request.auth.uid ||
            isTeamCoachOfPlayer(playerId)
          ));

        // ── CREATE / UPDATE ──────────────────────────────────────────────────
        // request.resource.data is available for create and update.
        // Coaches include updatedByTeamId in written data; rule verifies ownership.
        allow create, update: if isSuperAdmin() || (isSignedIn() && (
          (request.resource.data.get('updatedByTeamId', '') != '' &&
           exists(/databases/$(database)/documents/teams/$(request.resource.data.updatedByTeamId)) &&
           isTeamOwner(request.resource.data.updatedByTeamId)) ||
          get(/databases/$(database)/documents/players/$(playerId)).data.get('userId', '') == request.auth.uid ||
          isTeamCoachOfPlayer(playerId) ||
          playerId == request.auth.uid
        ));

        // ── DELETE ───────────────────────────────────────────────────────────
        // request.resource is NULL for deletes — use resource.data (the existing doc).
        // If updatedByTeamId was set when the doc was last written, use it.
        // Otherwise fall back to player-self or coach checks.
        allow delete: if isSuperAdmin() || (isSignedIn() && (
          get(/databases/$(database)/documents/players/$(playerId)).data.get('userId', '') == request.auth.uid ||
          isTeamCoachOfPlayer(playerId) ||
          playerId == request.auth.uid ||
          (resource.data.get('updatedByTeamId', '') != '' &&
           exists(/databases/$(database)/documents/teams/$(resource.data.updatedByTeamId)) &&
           isTeamOwner(resource.data.updatedByTeamId))
        ));
      }
    }

    // ─── Leagues ────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      // Use the document being evaluated so creator-scoped collection queries
      // can be proven by Firestore without a separate get() returning null.
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.get('creatorId', '') == request.auth.uid ||
        resource.data.get('memberUserIds', []).hasAny([request.auth.uid])
      ));
      // Browser-created leagues start with their organizer only. Cloud Functions
      // later expand memberUserIds from enrolled team memberships.
      allow create: if isSuperAdmin() || (isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.get('memberUserIds', []).size() == 1 &&
        request.resource.data.get('memberUserIds', []).hasAll([request.auth.uid])
      );
      // Only organizers may modify league operations. Browser clients cannot
      // change the access cache; trusted server code is the sole writer.
      allow update: if isSuperAdmin() || (isSignedIn() &&
        resource.data.creatorId == request.auth.uid &&
        request.resource.data.get('memberUserIds', []) == resource.data.get('memberUserIds', [])
      );
      allow delete: if isSuperAdmin() || (isSignedIn() &&
        resource.data.creatorId == request.auth.uid
      );

      match /registrationEntries/{entryId} {
        allow create: if isLeagueMember(leagueId);
        allow read: if isSuperAdmin() || isLeagueMember(leagueId);
        allow update, delete: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
      }

      match /archived_waivers/{waiverId} {
        allow read, write: if isSignedIn() && 
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid;
      }

      match /registration/{configId} {
        allow read: if isSuperAdmin() || isLeagueMember(leagueId);
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
      }

      match /scores/{scoreId} {
        allow read: if isSuperAdmin() || isLeagueMember(leagueId);
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow read: if isSuperAdmin() || isLeagueMember(leagueId);
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
      }

      match /divisions/{divisionId} {
        allow read: if isSuperAdmin() || isLeagueMember(leagueId);
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);

        match /{subCollection}/{docId} {
          allow read: if isSuperAdmin() || isLeagueMember(leagueId);
          allow write: if isSuperAdmin() || (isSignedIn() &&
            get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);

          match /{deepCollection}/{deepDocId} {
            allow read: if isSuperAdmin() || isLeagueMember(leagueId);
            allow write: if isSuperAdmin() || (isSignedIn() &&
              get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
          }
        }
      }

      match /accessRedemptions/{redemptionId} {
        allow read: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/leagues/$(leagueId)).data.creatorId == request.auth.uid);
        allow write: if false;
      }
    }

    // Spectator pages use a server-produced projection with schedule, standings,
    // and roster display information only. Clients can never write this data.
    match /publicLeagueViews/{leagueId} {
      // A spectator who has the direct league link may read that one projection,
      // but public collection enumeration is never allowed.
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ─── Leagues global invites ───────────────────────────────────────────────
    // FIX #5: write restricted to superadmin only (was isSignedIn())
    match /leagues/global/invites/{inviteId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Tournament Hubs ─────────────────────────────────────────────────────
    match /tournaments/{hubId} {
      function isTournamentMember() {
        return isSignedIn() && (
          get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(hubId))
            .data.get('memberUserIds', []).hasAny([request.auth.uid])
        );
      }

      allow read: if isSuperAdmin() || isTournamentMember();
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && (
        resource.data.creatorId == request.auth.uid
      ));
      allow delete: if isSuperAdmin() || (isSignedIn() && (
        resource.data.creatorId == request.auth.uid
      ));

      match /divisions/{divisionId} {
        allow read: if isSuperAdmin() || isTournamentMember();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid);

        match /{subCollection}/{docId} {
          allow read: if isSuperAdmin() || isTournamentMember();
          allow write: if isSuperAdmin() || (isSignedIn() &&
            get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid);

          match /{deepCollection}/{deepDocId} {
            allow read: if isSuperAdmin() || isTournamentMember();
            allow write: if isSuperAdmin() || (isSignedIn() &&
              get(/databases/$(database)/documents/tournaments/$(hubId)).data.creatorId == request.auth.uid);
          }
        }
      }
    }

    // ─── Plans ──────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── Subscriptions ───────────────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ─── Calendar feeds ──────────────────────────────────────────────────────
    match /calendarFeeds/{feedId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Volunteers ──────────────────────────────────────────────────────────
    match /volunteerOpportunities/{oppId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /signups/{signupId} {
        allow read: if true;
        // FIX #3: Was `if true` (fully public) — now requires auth to prevent spam signups
        allow write: if isSignedIn();
      }
    }

    // ─── Signatures ──────────────────────────────────────────────────────────
    match /signatures/{sigId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ─── Alerts ──────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || (
        isSignedIn() && (
          request.resource.data.createdBy == request.auth.uid &&
          (
            request.resource.data.teamId == null ||
            isTeamMember(request.resource.data.teamId) ||
            isTeamOwner(request.resource.data.teamId)
          )
        )
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && resource.data.createdBy == request.auth.uid
      );
    }

    // ─── Facilities ───────────────────────────────────────────────────────────
    match /facilities/{facilityId} {
      // Facility records can include private operational notes such as access
      // instructions. Only the creator and the global superadmin may read them.
      allow read: if isSuperAdmin() || (
        isSignedIn() && resource.data.clubId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.clubId == request.auth.uid;
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        resource.data.clubId == request.auth.uid &&
        request.resource.data.clubId == resource.data.clubId &&
        request.resource.data.get('isDemo', false) == resource.data.get('isDemo', false)
      );
      // Deletion must use the authenticated server endpoint so linked schedules
      // are checked and nested resources are removed atomically.
      allow delete: if false;

      match /fields/{fieldId} {
        function isFacilityOwner() {
          return isSignedIn() &&
            get(/databases/$(database)/documents/facilities/$(facilityId)).data.clubId == request.auth.uid;
        }

        allow read: if isSuperAdmin() || isFacilityOwner();
        allow create: if isSuperAdmin() || (
          isFacilityOwner() &&
          request.resource.data.facilityId == facilityId
        );
        allow update: if isSuperAdmin() || (
          isFacilityOwner() &&
          request.resource.data.get('facilityId', facilityId) ==
            resource.data.get('facilityId', facilityId) &&
          request.resource.data.get('isDemo', false) ==
            resource.data.get('isDemo', false)
        );
        allow delete: if false;
      }
    }


    // ─── Features ────────────────────────────────────────────────────────────
    match /features/{featureId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── Clubs ───────────────────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      match /{subCollection}/{docId} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin() || (isSignedIn() &&
          get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }
    }

    // ─── Invites ─────────────────────────────────────────────────────────────
    // Youth invitation lookup and single-use redemption are server-mediated.
    // The browser can never list child/family invitation PII.
    match /invites/{inviteId} {
      allow read, delete: if isSuperAdmin();
      allow create, update: if false;
    }

    // ─── Beta Tester System ──────────────────────────────────────────────────
    match /beta_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /bug_reports/{bugId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /beta_notifications/{notifId} {
      allow create, update, delete: if isSuperAdmin();
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBetaTester == true
      );
    }

    // ─── CollectionGroup Rules ───────────────────────────────────────────────
    match /{path=**}/members/{memberId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.parentId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        (resource.data.schoolId != null && (isTeamMember(resource.data.schoolId) || isTeamOwner(resource.data.schoolId)))
      ));
    }

    match /{path=**}/events/{eventId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        (
          resource.data.teamId != null &&
          (isTeamMember(resource.data.teamId) || isTeamOwner(resource.data.teamId))
        )
      ));
    }

    match /{path=**}/signatures/{sigId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        (resource.data.teamId != null && (isTeamOwner(resource.data.teamId) || isTeamMember(resource.data.teamId)))
      ));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /{path=**}/documents/{docId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /{path=**}/incidents/{incidentId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /{path=**}/registrationEntries/{entryId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.assigned_team_owner_id == request.auth.uid ||
        (resource.data.league_id != null && get(/databases/$(database)/documents/leagues/$(resource.data.league_id)).data.creatorId == request.auth.uid)
      ));
    }

    // ─── Newsletter signups ───────────────────────────────────────────────────
    match /newsletter_signups/{docId} {
      // Legacy collection retained for historical signups. New subscriptions
      // use the rate-limited server endpoint and canonical collection below.
      allow create: if false;
      allow read, delete: if isSuperAdmin();
    }

    // Canonical newsletter contacts and campaign history are written only by
    // authenticated server routes. Superadmins may read them for the dashboard,
    // but browser clients cannot alter consent or delivery records directly.
    match /newsletter_subscribers/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /newsletter_campaigns/{campaignId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /newsletter_system/{configId} {
      allow read, write: if false;
    }

    // ─── Contact Inquiries (enterprise contact form) ──────────────────────────
    // The rate-limited server endpoint owns all writes and email delivery.
    // Superadmin-only reads protect names, emails, and inquiry text.
    match /contact_inquiries/{docId} {
      allow read, delete: if isSuperAdmin();
      allow create, update: if false;
    }
  }
}
