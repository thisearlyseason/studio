rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }

    function playerData(playerId) {
      return firestore.get(/databases/(default)/documents/players/$(playerId)).data;
    }

    function canManagePlayer(playerId) {
      let player = playerData(playerId);
      let teamId = player.get('primaryTeamId', player.get('teamId', ''));
      return isSuperAdmin() || (isSignedIn() && (
        player.get('userId', '') == request.auth.uid ||
        player.get('parentId', '') == request.auth.uid ||
        (
          teamId != '' &&
          firestore.get(/databases/(default)/documents/teams/$(teamId))
            .data.ownerUserId == request.auth.uid
        )
      ));
    }

    function hasSafeImageUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function hasSafeVideoUpload() {
      return request.resource.size <= 500 * 1024 * 1024 &&
        request.resource.contentType.matches('video/(mp4|webm|quicktime|x-m4v)');
    }

    // Recruiting media is public only while the athlete explicitly enables
    // their scout profile. Family and the primary squad owner retain access.
    match /players/{playerId}/thumbnails/{fileName} {
      allow read: if playerData(playerId).get('recruitingProfileEnabled', false) == true ||
        canManagePlayer(playerId);
      allow create, update: if canManagePlayer(playerId) && hasSafeImageUpload();
      allow delete: if canManagePlayer(playerId);
    }

    match /players/{playerId}/avatar/{fileName} {
      allow read: if playerData(playerId).get('recruitingProfileEnabled', false) == true ||
        canManagePlayer(playerId);
      allow create, update: if canManagePlayer(playerId) && hasSafeImageUpload();
      allow delete: if canManagePlayer(playerId);
    }

    match /players/{playerId}/videos/{fileName} {
      allow read: if playerData(playerId).get('recruitingProfileEnabled', false) == true ||
        canManagePlayer(playerId);
      allow create, update: if canManagePlayer(playerId) && hasSafeVideoUpload();
      allow delete: if canManagePlayer(playerId);
    }

    // Only explicitly branded team assets are public.
    match /teams/{teamId}/branding/{allPaths=**} {
      allow read: if true;
      allow create, update: if (
        isSuperAdmin() ||
        (
          isSignedIn() &&
          firestore.get(/databases/(default)/documents/teams/$(teamId))
            .data.ownerUserId == request.auth.uid
        )
      ) && hasSafeImageUpload();
      allow delete: if isSuperAdmin() || (
        isSignedIn() &&
        firestore.get(/databases/(default)/documents/teams/$(teamId))
          .data.ownerUserId == request.auth.uid
      );
    }

    match /users/{userId}/avatar.jpg {
      allow read: if isSignedIn();
      allow create, update: if (
        isSuperAdmin() || (isSignedIn() && request.auth.uid == userId)
      ) && hasSafeImageUpload();
      allow delete: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // No implicit public bucket. Every supported asset path is declared above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
